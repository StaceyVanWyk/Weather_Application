<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiWeather_Application.MainPage"
    Title="Weather">

    <ScrollView>
        <VerticalStackLayout
            Padding="25"
            Spacing="20"
            VerticalOptions="Center">

            <Label
                Text="Weather App"
                FontSize="30"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Get your current location"
                FontSize="18"
                HorizontalOptions="Center" />

            <Button
                Text="Get My Location"
                Command="{Binding GetLocationCommand}"
                HorizontalOptions="Fill" />

            <ActivityIndicator
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                HorizontalOptions="Center" />

            <Label
                Text="Latitude"
                FontAttributes="Bold" />

            <Label
                Text="{Binding Latitude, StringFormat='{0:F6}'}"
                FontSize="18" />

            <Label
                Text="Longitude"
                FontAttributes="Bold" />

             
<Label
    Text="Current Weather"
    FontSize="24"
    FontAttributes="Bold"
    HorizontalOptions="Center" />

<Label
    Text="{Binding Weather.Name}"
    FontSize="22"
    HorizontalOptions="Center" />

<Label
    Text="{Binding Weather.Main.Temperature, StringFormat='{0:F1} °C'}"
    FontSize="40"
    FontAttributes="Bold"
    HorizontalOptions="Center" />

<Label
    Text="{Binding Weather.Weather[0].Description}"
    FontSize="18"
    HorizontalOptions="Center" />

<Label
    Text="{Binding Weather.Main.FeelsLike, StringFormat='Feels like {0:F1} °C'}" />

<Label
    Text="{Binding Weather.Main.Humidity, StringFormat='Humidity: {0}%'}" />

<Label
    Text="{Binding Weather.Wind.Speed, StringFormat='Wind speed: {0} m/s'}" />
   

            <Label
                Text="{Binding Longitude, StringFormat='{0:F6}'}"
                FontSize="18" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

